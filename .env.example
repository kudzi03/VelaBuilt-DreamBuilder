# Public URL used for canonical + social share metadata (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://demo.velabuilt.com

# VelaBuilt WhatsApp number in international format, digits only (e.g. 263771234567).
# Leave empty to hide WhatsApp contact buttons.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Contact email shown in the demo and used for enquiries
NEXT_PUBLIC_CONTACT_EMAIL=jace@velabuilt.com

# --- Lead delivery (any combination; if none are set, the form offers email/WhatsApp hand-off) ---
LEAD_NOTIFY_EMAIL=jace@velabuilt.com
# Resend (https://resend.com) — sends each enquiry as an email
RESEND_API_KEY=
LEAD_FROM_EMAIL=VelaBuilt Demo <demo@velabuilt.com>
# Generic webhook (Zapier / Make / n8n / your CRM). Receives JSON.
LEAD_WEBHOOK_URL=
# Supabase (stores leads + analytics events; see README for table SQL)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
